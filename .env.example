# ============================================================
# United Tractors Asset Management System — Environment Config
# ============================================================
# Copy this file to `.env` and fill in the real values.
# `.env` contains secrets and must never be committed.

# --- SMTP Server ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-smtp-username@example.com
SMTP_PASSWORD=your-smtp-password-or-app-password

# Encryption: tls (port 587) or ssl (port 465)
SMTP_ENCRYPTION=tls

# --- Sender identity ---
MAIL_FROM_NAME=UT Asset Management System
MAIL_FROM_ADDRESS=your-smtp-username@example.com

# Admin notification recipients are resolved from users.email where role = admin.
# MAIL_ADMIN_ADDRESS is intentionally not used by the runtime.

# --- Application base URL (used for absolute links in e-mails) ---
# Example: APP_URL=https://assets.unitedtractors.com
APP_URL=

# --- Database ---
# Local (XAMPP) defaults: localhost / root / empty / db_ut_assets.
# On InfinityFree replace with the hosting values (e.g. DB_HOST=sqlXXX.epizy.com).
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=db_ut_assets

# --- Google Spreadsheet Sync ---
# Leave SPREADSHEET_WEB_APP_URL empty to disable sync.
SPREADSHEET_WEB_APP_URL=
SPREADSHEET_TOKEN=
SPREADSHEET_TIMEOUT=3

# --- Uploads ---
# Default: 5 MB. Value is bytes.
UPLOAD_MAX_SIZE=5242880
