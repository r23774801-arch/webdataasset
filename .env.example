# ============================================================
# United Tractors Asset Management System — Environment Config
# ============================================================
# Copy this file to `.env` and fill in the real values.
# `.env` contains secrets and must never be committed.

# --- SMTP Server ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-smtp-username@example.com
SMTP_PASSWORD=your-smtp-password-or-app-password

# Encryption: tls (port 587) or ssl (port 465)
SMTP_ENCRYPTION=tls

# --- Sender identity ---
MAIL_FROM_NAME=UT Asset Management System
MAIL_FROM_ADDRESS=your-smtp-username@example.com


# --- Application base URL (used for absolute links in e-mails) ---
# Example: APP_URL=https://assets.unitedtractors.com
APP_URL=
